<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <UseWindowsForms>true</UseWindowsForms>
    <MonoGamePlatform>DesktopGL</MonoGamePlatform>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" />
    <EmbeddedResource Include="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <UpToDateCheckInput Include="..\Monofoxe.Template.Content\Content\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Monofoxe.Engine.WindowsGL" Version="3.0.0-dev.2" />
    <PackageReference Include="Monofoxe.Tiled" Version="3.0.0-dev.2" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Monofoxe.Template\Monofoxe.Template.csproj" />
  </ItemGroup>
  <Import Project="..\Monofoxe.Template.Content\BuildContent.targets" />
</Project>
